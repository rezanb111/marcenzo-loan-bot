# ================================
# Telegram Bot
# ================================
BOT_TOKEN=your_bot_token_here

# ================================
# xRocket Pay API
# ================================
XROCKET_API_KEY=your_xrocket_jwt_token_here
XROCKET_BASE_URL=https://pay.api.xrocket.exchange
# For testing use: https://pay.api.testnet.xrocket.exchange

# ================================
# Telegram API (optional - for advanced features)
# ================================
API_ID=your_api_id
API_HASH=your_api_hash

# ================================
# Admins (Telegram usernames without @)
# ================================
ADMINS=marcenzo,shibainuo

# ================================
# Database
# ================================
DATABASE_URL=sqlite+aiosqlite:///./data/loan_bot.db
# For production: postgresql+asyncpg://user:pass@host:5432/dbname

# ================================
# Loan Settings
# ================================
DEFAULT_CURRENCY=USDT
MIN_LOAN_AMOUNT=5
MAX_LOAN_AMOUNT=100
INITIAL_CREDIT_LIMIT=5
CREDIT_MULTIPLIER=2
SUCCESSFUL_LOANS_FOR_UPGRADE=3
DEFAULT_INSTALLMENTS=5
MAX_INSTALLMENTS=10
LATE_FEE_PERCENT=5

# ================================
# Bot Settings
# ================================
DEFAULT_LANGUAGE=en
SUPPORT_USERNAME=marcenzo
